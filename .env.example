# ==========================================
# CẤU HÌNH DATABASE MONGODB (LOCAL / VPS)
# ==========================================
MONGO_URI=mongodb://127.0.0.1:27017/real_estate_db
MONGO_DB_NAME=real_estate_db

# ==========================================
# CẤU HÌNH CRAWLER HISALE
# ==========================================
HISALE_PHONE=your_phone_number
HISALE_PASSWORD=your_password
HISALE_PROJECT_IDS=ALL
HISALE_COOKIE=
HISALE_XSRF_TOKEN=

# ==========================================
# CẤU HÌNH CRAWLER SALEPRO
# ==========================================
SALEPRO_EMAIL=your_email@example.com
SALEPRO_PASSWORD=your_password
SALEPRO_PROJECT_IDS=ALL
SALEPRO_COORDINATE_MANAGER_ID=645
SALEPRO_AUTH_TOKEN=
SALEPRO_COOKIE=

# ==========================================
# CẤU HÌNH CRAWLER VHUB 360 (vhub.com.vn)
# ==========================================
VHUB_API_URL=https://api.vhub.com.vn
VHUB_EMAIL=your_email@gmail.com
VHUB_PASSWORD=your_password
VHUB_PROJECT_IDS=ALL

# ==========================================
# CẤU HÌNH GỬI MAIL SMTP (GMAIL)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="Bot Quản Lý Giỏ Hàng BĐS" <your_email@gmail.com>
MAIL_TO=recipient1@gmail.com,recipient2@gmail.com

# ==========================================
# CẤU HÌNH LỊCH CHẠY TỰ ĐỘNG (CRON JOB)
# ==========================================
# 1. Lịch cào dữ liệu (5 lần/ngày: 06:00, 10:00, 14:00, 18:00, 22:00)
CRON_SCHEDULE=0 6,10,14,18,22 * * *

# 2. Lịch gửi email báo cáo ngày (Đúng 07:00 sáng gửi 1 email tổng hợp duy nhất kèm file Excel):
MAIL_CRON_SCHEDULE=0 7 * * *

# Múi giờ hoạt động
CRON_TIMEZONE=Asia/Ho_Chi_Minh

# ==========================================
# CẤU HÌNH BÁO CÁO NGÀY
# ==========================================
# 'DAILY' (gửi mỗi sáng kể cả khi không có căn mới) hoặc 'NEW_ONLY' (chỉ gửi khi có căn mới)
MAIL_REPORT_MODE=DAILY
MAIL_ON_ERROR=true
MAIL_MAX_PREVIEW_UNITS=15

# ==========================================
# CẤU HÌNH BÁO CÁO TUẦN (WEEKLY REPORT)
# ==========================================
WEEKLY_REPORT_ENABLED=true
# 06:00 sáng Thứ Hai hàng tuần (Tổng hợp từ 00:00 thứ Hai tuần trước đến 00:00 thứ Hai tuần này)
WEEKLY_REPORT_CRON=0 6 * * 1

# ==========================================
# CẤU HÌNH GOOGLE DRIVE API V3
# ==========================================
GOOGLE_DRIVE_ENABLED=false
# Tên thư mục tổng mặc định (có thể đổi sang tên Drive công ty sau này)
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Real_Estate_Crawler_Test
# Folder ID thư mục tổng (được điền tự động khi chạy npm run drive:create-root)
GOOGLE_DRIVE_ROOT_FOLDER_ID=1QLSf5pecivmn6KfPNCrJlbUHMPRfYpuk
GOOGLE_DRIVE_CREDENTIALS=./credentials/credentials.json
GOOGLE_DRIVE_TOKEN=./credentials/token.json

# ==========================================
# CẤU HÌNH MEDIA & IMAGE STORAGE
# ==========================================
IMAGE_SYNC_ENABLED=false
# Chu kỳ quét đồng bộ hình ảnh (mặc định mỗi 15 phút)
IMAGE_SYNC_CRON=*/15 * * * *
# Số lượng căn tối đa xử lý trong 1 batch
IMAGE_SYNC_BATCH_SIZE=20
# Số luồng upload đồng thời lên Google Drive
IMAGE_UPLOAD_CONCURRENCY=2
# Giới hạn dung lượng tối đa cho mỗi file ảnh (MB)
IMAGE_MAX_SIZE_MB=0 # Giới hạn dung lượng ảnh tải về (MB) (0 = không giới hạn dung lượng)
# Số lần thử lại tối đa khi gặp lỗi mạng/quota
IMAGE_MAX_RETRIES=3
# Giới hạn số lượng ảnh phối cảnh/banner dự án tối đa (0 = không giới hạn, lấy toàn bộ)
IMAGE_MAX_PROJECT_IMAGES=0

# ==========================================
# CẤU HÌNH ĐỒNG BỘ MEDIA DỰ ÁN SALEPRO V3
# ==========================================
# Tự động đồng bộ media cấp dự án (mặc định 02:00 sáng hàng ngày)
PROJECT_MEDIA_SYNC_ENABLED=true
PROJECT_MEDIA_SYNC_CRON=0 2 * * *
PROJECT_MEDIA_SYNC_BATCH_SIZE=10
